{
  "entities": {
    "Course": {
      "title": "Course",
      "description": "A learning course offered on the platform",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the course" },
        "subtitle": { "type": "string" },
        "tagline": { "type": "string" },
        "slug": { "type": "string" },
        "thumbnail": { "type": "string" },
        "description": { "type": "string" },
        "overview": { "type": "string" },
        "category": { "type": "string" },
        "skill": { "type": "string" },
        "subskill": { "type": "string" },
        "youtube_link": { "type": "string" },
        "level": { "type": "string", "enum": ["Beginner", "Advanced", "Masterclass"] },
        "tier": { "type": "string", "enum": ["beginner", "advanced", "masterclass"] },
        "price": { "type": "number" },
        "instructor": { "type": "string" },
        "outcomes": { "type": "string" },
        "requirements": { "type": "string" },
        "publish_status": { "type": "string", "enum": ["Draft", "Published", "Archived"] },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "isLocked": { "type": "boolean" },
        "days": { "type": "array", "description": "5 days of videos and themes" },
        "createdAt": { "type": "string", "format": "timestamp" },
        "updatedAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["title", "publish_status", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile with onboarding data",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "intent": { "type": "string" },
        "experience": { "type": "string" },
        "pathwaySelection": { "type": "string" },
        "pathwayReason": { "type": "string" },
        "pathwayExperience": { "type": "string" },
        "recommendedPath": { "type": "string" },
        "goal": { "type": "string" },
        "availability": { "type": "string" },
        "fullName": { "type": "string" },
        "whatsapp": { "type": "string" },
        "state": { "type": "string" },
        "referralCode": { "type": "string" },
        "myReferralCode": { "type": "string" },
        "isActivated": { "type": "boolean" },
        "referralsCount": { "type": "number" },
        "approvalStatus": { "type": "string", "enum": ["Pending", "Approved", "Disapproved"] },
        "isDashboardUnlocked": { "type": "boolean" },
        "adminCode": { "type": "string" },
        "progress": { "type": "object" },
        "createdAt": { "type": "string", "format": "timestamp" },
        "updatedAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["email", "createdAt", "updatedAt"]
    },
    "AdminConfig": {
      "title": "Admin Configuration",
      "description": "Configuration to store admin user IDs",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string" },
        "permissions": { "type": "array" }
      },
      "required": ["email"]
    },
    "KycbQuestionnaire": {
      "title": "KYCB Questionnaire",
      "description": "Know your client business questionnaire document containing target audience, project goals, branding, content, and dynamic features",
      "type": "object",
      "properties": {
        "clientName": { "type": "string" },
        "dateCompleted": { "type": "string" },
        "type": { "type": "string", "enum": ["lp", "ec"] },
        "businessName": { "type": "string" },
        "createdAt": { "type": "string", "format": "timestamp" },
        "data": { "type": "object" }
      },
      "required": ["clientName", "type", "businessName", "createdAt", "data"]
    },
    "AppSettings": {
      "title": "Application Settings",
      "description": "Dynamic configurations for prompt generator templates, shufflers, and modular options",
      "type": "object",
      "properties": {
        "landing": { "type": "array" },
        "ecommerce": { "type": "array" },
        "templates": { "type": "array" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/settings/{settingsDoc}": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "Global config documents for general templates, locks and prompt shuffling definitions."
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "The main collection for all courses."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminConfig" },
      "description": "List of admin users allowed to manage the system."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles and onboarding data."
    },
    "/kycb_questionnaires/{questionnaireId}": {
      "schema": { "$ref": "#/entities/KycbQuestionnaire" },
      "description": "Questionnaire sheets for active client systems."
    }
  }
}
