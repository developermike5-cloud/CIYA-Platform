{
  "entities": {
    "Course": {
      "title": "Course",
      "description": "A learning course offered on the platform",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the course" },
        "subtitle": { "type": "string" },
        "tagline": { "type": "string" },
        "slug": { "type": "string" },
        "thumbnail": { "type": "string" },
        "description": { "type": "string" },
        "overview": { "type": "string" },
        "category": { "type": "string" },
        "skill": { "type": "string" },
        "subskill": { "type": "string" },
        "skillPath": { "type": "string" },
        "durationMode": { "type": "string" },
        "youtube_link": { "type": "string" },
        "level": { "type": "string", "enum": ["Beginner", "Advanced", "Masterclass"] },
        "tier": { "type": "string", "enum": ["beginner", "advanced", "masterclass"] },
        "price": { "type": "number" },
        "instructor": { "type": "string" },
        "outcomes": { "type": "string" },
        "requirements": { "type": "string" },
        "publish_status": { "type": "string", "enum": ["Draft", "Published", "Archived"] },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "isLocked": { "type": "boolean" },
        "days": { "type": "array", "description": "5 days of videos and themes" },
        "createdAt": { "type": "string", "format": "timestamp" },
        "updatedAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["title", "publish_status", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile with onboarding data",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "intent": { "type": "string" },
        "experience": { "type": "string" },
        "courseType": { "type": "string" },
        "pathwaySelection": { "type": "string" },
        "pathwayReason": { "type": "string" },
        "pathwayExperience": { "type": "string" },
        "recommendedPath": { "type": "string" },
        "goal": { "type": "string" },
        "availability": { "type": "string" },
        "fullName": { "type": "string" },
        "gender": { "type": "string" },
        "ageRange": { "type": "string" },
        "learningTool": { "type": "string" },
        "educationLevel": { "type": "string" },
        "whatsapp": { "type": "string" },
        "state": { "type": "string" },
        "referralCode": { "type": "string" },
        "myReferralCode": { "type": "string" },
        "isActivated": { "type": "boolean" },
        "referralsCount": { "type": "number" },
        "approvalStatus": { "type": "string", "enum": ["Pending", "Approved", "Disapproved"] },
        "isDashboardUnlocked": { "type": "boolean" },
        "adminCode": { "type": "string" },
        "country": { "type": "string" },
        "cohort": { "type": "string" },
        "registeredCourses": { "type": "array" },
        "congratulatedCourses": { "type": "array" },
        "completedCoursesOverride": { "type": "array" },
        "manualDayUnlock": { "type": "object" },
        "membershipId": { "type": "string" },
        "badgePaymentRequestStatus": { "type": "string" },
        "hasYearBadge": { "type": "boolean" },
        "badgeExpiresAt": { "type": "string" },
        "badgeStatus": { "type": "string" },
        "badgePlan": { "type": "string" },
        "badgePrice": { "type": "number" },
        "badgeApprovedAt": { "type": "string" },
        "badgeTxRef": { "type": "string" },
        "paymentReference": { "type": "string" },
        "photoURL": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "promptCopies": { "type": "array" },
        "role": { "type": "string" },
        "progress": { "type": "object" },
        "createdAt": { "type": "string", "format": "timestamp" },
        "updatedAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["email", "createdAt", "updatedAt"]
    },
    "AdminConfig": {
      "title": "Admin Configuration",
      "description": "Configuration to store admin user IDs",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string" },
        "permissions": { "type": "array" }
      },
      "required": ["email"]
    },
    "KycbQuestionnaire": {
      "title": "KYCB Questionnaire",
      "description": "Know your client business questionnaire document containing target audience, project goals, branding, content, and dynamic features",
      "type": "object",
      "properties": {
        "clientName": { "type": "string" },
        "dateCompleted": { "type": "string" },
        "type": { "type": "string", "enum": ["lp", "ec"] },
        "businessName": { "type": "string" },
        "createdAt": { "type": "string", "format": "timestamp" },
        "data": { "type": "object" },
        "userId": { "type": "string", "description": "The student user ID" },
        "userEmail": { "type": "string", "description": "The student email" }
      },
      "required": ["clientName", "type", "businessName", "createdAt", "data"]
    },
    "SavedPrompt": {
      "title": "Saved Student Prompt",
      "description": "Student generated and stored full prompt with industry annotations",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The student user ID" },
        "industry": { "type": "string", "description": "The industry/niche of the prompt" },
        "promptText": { "type": "string", "description": "The exact full compiled prompt" },
        "websiteType": { "type": "string", "enum": ["landing", "ecommerce"] },
        "businessName": { "type": "string" },
        "createdAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["userId", "industry", "promptText", "websiteType", "createdAt"]
    },
    "AssignmentSubmission": {
      "title": "Assignment Submission",
      "description": "A submission made by a student for a specific lesson/day assignment",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "courseId": { "type": "string" },
        "dayIndex": { "type": "number" },
        "submittedText": { "type": "string" },
        "fileUrl": { "type": "string" },
        "fileName": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Disapproved"] },
        "adminReason": { "type": "string" },
        "gradedBy": { "type": "string" },
        "gradedAt": { "type": "string", "format": "timestamp" },
        "createdAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["userId", "courseId", "dayIndex", "status", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notification system for students and admins",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "timestamp" },
        "triggeredBy": { "type": "string" },
        "triggerType": { "type": "string", "enum": ["manual", "automatic"] }
      },
      "required": ["userId", "title", "message", "isRead", "createdAt"]
    },
    "NotificationTemplate": {
      "title": "Notification Template",
      "description": "Admin configured notification layouts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "triggerType": { "type": "string" },
        "eventType": { "type": "string" },
        "createdAt": { "type": "string", "format": "timestamp" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "title", "message", "triggerType", "eventType", "createdAt"]
    },
    "AppSettings": {
      "title": "Application Settings",
      "description": "Dynamic configurations for prompt generator templates, shufflers, and modular options",
      "type": "object",
      "properties": {
        "landing": { "type": "array" },
        "ecommerce": { "type": "array" },
        "templates": { "type": "array" },
        "updatedAt": { "type": "string" }
      }
    },
    "BlogPost": {
      "title": "Blog Post",
      "description": "An article published by admins for students to read",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the blog post" },
        "content": { "type": "string", "description": "Body content of the blog post" },
        "imageUrl": { "type": "string", "description": "Optional image link" },
        "author": { "type": "string", "description": "Author name" },
        "createdAt": { "type": "string", "format": "timestamp" },
        "updatedAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["title", "content", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/settings/{settingsDoc}": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "Global config documents for general templates, locks and prompt shuffling definitions."
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "The main collection for all courses."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminConfig" },
      "description": "List of admin users allowed to manage the system."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles and onboarding data."
    },
    "/kycb_questionnaires/{questionnaireId}": {
      "schema": { "$ref": "#/entities/KycbQuestionnaire" },
      "description": "Questionnaire sheets for active client systems."
    },
    "/saved_prompts/{promptId}": {
      "schema": { "$ref": "#/entities/SavedPrompt" },
      "description": "Exhaustive developer prompts saved by students."
    },
    "/assignments/{submissionId}": {
      "schema": { "$ref": "#/entities/AssignmentSubmission" },
      "description": "Submissions made by students for assignments."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "System or personal student/admin notifications."
    },
    "/notification_templates/{templateId}": {
      "schema": { "$ref": "#/entities/NotificationTemplate" },
      "description": "Custom templates for manual and automatic notifications."
    },
    "/blog/{postId}": {
      "schema": { "$ref": "#/entities/BlogPost" },
      "description": "Blog posts and articles published by administrators."
    }
  }
}
