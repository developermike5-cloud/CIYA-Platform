rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    function isAdmin() { 
      // Bootstrap admin using email, or check if they are in the admins collection
      return isSignedIn() && request.auth.token.email_verified == true && (
        request.auth.token.email == 'developermike5@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    function isOwner() {
      return existing().userId == request.auth.uid;
    }

    // Entity Validation: Course
    function isValidCourse(data) {
      return data.keys().hasAll(['title', 'publish_status', 'createdAt', 'updatedAt']) 
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.publish_status in ['Draft', 'Published', 'Archived']
        && (data.get('subtitle', '') is string && data.get('subtitle', '').size() <= 1000)
        && (data.get('tagline', '') is string && data.get('tagline', '').size() <= 1000)
        && (data.get('slug', '') is string && data.get('slug', '').size() <= 500)
        && (data.get('thumbnail', '') is string && data.get('thumbnail', '').size() <= 2000)
        && (data.get('description', '') is string && data.get('description', '').size() <= 10000)
        && (data.get('overview', '') is string && data.get('overview', '').size() <= 10000)
        && (data.get('category', '') is string && data.get('category', '').size() <= 200)
        && (data.get('skill', '') is string && data.get('skill', '').size() <= 100)
        && (data.get('subskill', '') is string && data.get('subskill', '').size() <= 200)
        && (data.get('youtube_link', '') is string && data.get('youtube_link', '').size() <= 1000)
        && (data.get('level', '') is string && data.get('level', '').size() <= 100)
        && (data.get('tier', '') is string && data.get('tier', '').size() <= 100)
        && (data.get('price', 0) is int || data.get('price', 0) is float)
        && (data.get('instructor', '') is string && data.get('instructor', '').size() <= 500)
        && (data.get('outcomes', '') is string && data.get('outcomes', '').size() <= 10000)
        && (data.get('requirements', '') is string && data.get('requirements', '').size() <= 10000)
        && (data.get('status', '') is string && data.get('status', '').size() <= 100)
        && (data.get('days', []) is list && data.get('days', []).size() <= 15);
    }
    
    // Entity Validation: AdminConfig
    function isValidAdminConfig(data) {
      return data.keys().hasAll(['email']) && data.keys().size() == 1
        && data.email is string && data.email.size() <= 200;
    }

    // Entity Validation: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['email', 'createdAt', 'updatedAt'])
        && data.email is string && data.email.size() <= 200
        && (data.get('intent', '') is string && data.get('intent', '').size() <= 5000)
        && (data.get('experience', '') is string && data.get('experience', '').size() <= 5000)
        && (data.get('pathwaySelection', '') is string && data.get('pathwaySelection', '').size() <= 5000)
        && (data.get('pathwayReason', '') is string && data.get('pathwayReason', '').size() <= 5000)
        && (data.get('pathwayExperience', '') is string && data.get('pathwayExperience', '').size() <= 5000)
        && (data.get('recommendedPath', '') is string && data.get('recommendedPath', '').size() <= 5000)
        && (data.get('goal', '') is string && data.get('goal', '').size() <= 5000)
        && (data.get('availability', '') is string && data.get('availability', '').size() <= 5000)
        && (data.get('fullName', '') is string && data.get('fullName', '').size() <= 1000)
        && (data.get('whatsapp', '') is string && data.get('whatsapp', '').size() <= 500)
        && (data.get('state', '') is string && data.get('state', '').size() <= 500)
        && (data.get('referralCode', '') is string && data.get('referralCode', '').size() <= 500)
        && (data.get('myReferralCode', '') is string && data.get('myReferralCode', '').size() <= 500)
        && (data.get('isActivated', false) is bool)
        && (data.get('referralsCount', 0) is int || data.get('referralsCount', 0) is float)
        && (data.get('approvalStatus', 'Pending') is string && data.get('approvalStatus', 'Pending') in ['Pending', 'Approved', 'Disapproved'])
        && (data.get('isDashboardUnlocked', false) is bool)
        && (data.get('adminCode', '') is string)
        && (data.get('progress', {}) is map);
    }

    // Collections Routes
    match /admins/{adminId} {
      // Only root admin can manage admins
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && isValidId(adminId)
                    && isValidAdminConfig(incoming());
      allow update: if false; // immutable emails
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin() || isSignedIn();
      allow create: if isSignedIn() 
                    && request.auth.uid == userId 
                    && isValidUserProfile(incoming())
                    && incoming().email == request.auth.token.email
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;
      allow update: if isSignedIn() 
                    && (
                      isAdmin()
                      ||
                      (request.auth.uid == userId 
                       && isValidUserProfile(incoming())
                       && incoming().email == existing().email
                       && incoming().createdAt == existing().createdAt
                       && (incoming().updatedAt == request.time || incoming().updatedAt == existing().updatedAt)
                       && incoming().diff(existing()).affectedKeys().hasOnly([
                         'intent', 'experience', 'pathwaySelection', 'pathwayReason', 'pathwayExperience', 'recommendedPath', 'goal', 'availability', 'fullName', 'whatsapp', 'state', 'referralCode', 'myReferralCode', 'isActivated', 'referralsCount', 'isDashboardUnlocked', 'adminCode', 'progress', 'updatedAt'
                       ])
                      )
                      ||
                      (
                       isValidUserProfile(incoming())
                       && incoming().email == existing().email
                       && incoming().createdAt == existing().createdAt
                       && (incoming().updatedAt == request.time || incoming().updatedAt == existing().updatedAt)
                       && incoming().diff(existing()).affectedKeys().hasOnly(['isActivated', 'referralsCount', 'updatedAt'])
                       && incoming().isActivated == true
                       && incoming().referralsCount == existing().get('referralsCount', 0) + 1
                      )
                    );
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow get: if true; // Public can get individual courses
      allow list: if 
        // Public can list published courses, but we only permit the query if we filter properly?
        // Wait, for public reading:
        (resource.data.publish_status == 'Published' || isAdmin());
        
      allow create: if isAdmin() 
                    && isValidId(courseId)
                    && isValidCourse(incoming())
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;
      
      allow update: if isAdmin()
                    && isValidCourse(incoming())
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time
                    && incoming().diff(existing()).affectedKeys().hasOnly([
                      'title', 'subtitle', 'tagline', 'slug', 'thumbnail', 'description', 
                      'overview', 'category', 'skill', 'subskill', 'youtube_link', 
                      'level', 'tier', 'price', 'instructor', 'outcomes', 
                      'requirements', 'publish_status', 'status', 'days', 'updatedAt'
                    ]);
                    
      allow delete: if isAdmin();
    }

    match /settings/{settingsDoc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
