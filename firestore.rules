rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    function isBaseAdmin() {
      // Bootstrap admin by uid or email, or a users-doc admin role
      return isSignedIn()
        && (request.auth.uid == 'a26a8d1a-84d2-4baf-9e14-c8c2dec6a164'
            || ('email' in request.auth.token && request.auth.token.email.matches('(?i)^developermike5@gmail\\.com$'))
            || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'super_admin', 'superadmin']));
    }

    function isAdmin() { 
      // Check bootstrap/users table admin, or check if they are in the admins collection
      return isSignedIn() && (
        isBaseAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Permission helper: the admin record must explicitly grant this power.
    // 'all' is the superadmin wildcard. Base admin always passes.
    function permFromAdminsDoc(p) {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminDocPerm(get(/databases/$(database)/documents/admins/$(request.auth.uid)).data, p);
    }
    function adminDocPerm(ad, p) {
      return ad.get('role', '') == 'superadmin' || ad.get('permissions', []).hasAny(['all', p]);
    }

    function adminPerm(p) {
      return isSignedIn() && (isBaseAdmin() || permFromAdminsDoc(p));
    }
    
    function isOwner() {
      return existing().userId == request.auth.uid;
    }

    // ---- Beginner (free) course one-at-a-time rule (server-side) ----
    // A student may hold only ONE active free course. It must be completed
    // (progress.<id>.completedAt set, or the id is in completedCoursesOverride)
    // before the slot can move to another beginner course. Paid courses are exempt.
    function isBeginnerCourse(cid) {
      return !exists(/databases/$(database)/documents/courses/$(cid))
        || isBeginnerTier(get(/databases/$(database)/documents/courses/$(cid)).data);
    }
    function isBeginnerTier(cd) {
      return cd.get('tier', '') == 'beginner'
        || (cd.get('tier', '') == '' && (cd.get('level', '').lower() == 'beginner' || cd.get('level', '') == ''));
    }

    function courseCompletedIn(profile, cid) {
      return (cid in profile.get('completedCoursesOverride', []))
        || (profile.get('progress', {}).get(cid, {}).get('completedAt', '') is string
            && profile.get('progress', {}).get(cid, {}).get('completedAt', '') != '');
    }

    function slotCourseOf(s) { return s.get('courseId', ''); }
    function slotCompletedOf(s) { return s.get('completed', false); }

    function validBeginnerSlot() {
      return incoming().get('beginnerEnrollment', {}).keys().hasOnly(['courseId', 'completed', 'startedAt'])
        && incoming().get('beginnerEnrollment', {}).get('courseId', '') is string
        && incoming().get('beginnerEnrollment', {}).get('completed', false) is bool
        // Cannot claim a course is completed without the durable completion evidence
        && (
          slotCompletedOf(incoming().get('beginnerEnrollment', {})) == false
          || (slotCompletedOf(existing().get('beginnerEnrollment', {})) == true
              && slotCourseOf(existing().get('beginnerEnrollment', {})) == slotCourseOf(incoming().get('beginnerEnrollment', {})))
          || courseCompletedIn(incoming(), slotCourseOf(incoming().get('beginnerEnrollment', {})))
        )
        // Moving or clearing the slot requires the previous beginner course to be completed
        && (
          slotCourseOf(incoming().get('beginnerEnrollment', {})) == slotCourseOf(existing().get('beginnerEnrollment', {}))
          || (
            slotCourseOf(incoming().get('beginnerEnrollment', {})) == ''
            && (slotCourseOf(existing().get('beginnerEnrollment', {})) == ''
                || slotCompletedOf(existing().get('beginnerEnrollment', {})) == true
                || courseCompletedIn(existing(), slotCourseOf(existing().get('beginnerEnrollment', {}))))
          )
          || (
            isBeginnerCourse(slotCourseOf(incoming().get('beginnerEnrollment', {})))
            && (slotCourseOf(existing().get('beginnerEnrollment', {})) == ''
                || slotCompletedOf(existing().get('beginnerEnrollment', {})) == true
                || courseCompletedIn(existing(), slotCourseOf(existing().get('beginnerEnrollment', {}))))
          )
        );
    }

    // Changed-fields-only validation for user profile UPDATES. The full
    // isValidUserProfile stays for creates; updates validate only the keys a
    // write actually touches, which keeps rule evaluation far below the
    // per-request expression budget.
    function fieldIsStr(k, maxLen) {
      return incoming().get(k, '') is string && incoming().get(k, '').size() <= maxLen;
    }

    // Only shape checks the slot/referral logic depends on; other profile
    // fields are bounded by the allowed-keys list, not type checks.
    // Shape checks only for what the slot/referral logic depends on; every other
    // profile field is writable by its owner.
    function changedProfileOk(ak) {
      return (!ak.hasAny(['progress', 'manualDayUnlock', 'courseEnrollments']) || incoming().get('progress', {}) is map)
        && (!ak.hasAny(['completedCoursesOverride', 'registeredCourses', 'congratulatedCourses', 'enrolledCourses', 'promptCopies']) || incoming().get('completedCoursesOverride', []) is list)
        && (!ak.hasAny(['isActivated', 'isDashboardUnlocked', 'hasYearBadge']) || incoming().get('isActivated', false) is bool)
        && (!ak.hasAny(['referralsCount', 'badgePrice']) || incoming().get('referralsCount', 0) is number)
        && (!ak.hasAny(['approvalStatus']) || incoming().get('approvalStatus', '') in ['Pending', 'Approved', 'Disapproved']);
    }

    function emailUnchanged() {
      return !('email' in existing()) || incoming().email.lower() == existing().email.lower();
    }

    function createdAtUnchanged() {
      return !('createdAt' in existing()) || incoming().createdAt == existing().createdAt || incoming().createdAt == request.time;
    }

    function updatedAtOk() {
      return !('updatedAt' in incoming()) || incoming().updatedAt == request.time || incoming().updatedAt == existing().updatedAt;
    }

    function usersUpdateOk(uid) {
      let ak = incoming().diff(existing()).affectedKeys();
      return (request.auth.uid == uid
              && !ak.hasAny(['role', 'email', 'userId', 'createdAt', 'mustChangePassword', 'passwordChangedAt'])
              && changedProfileOk(ak)
              && emailUnchanged()
              && createdAtUnchanged()
              && updatedAtOk()
              && (!ak.hasAny(['beginnerEnrollment']) || validBeginnerSlot()))
        || (ak.hasOnly(['isActivated', 'referralsCount', 'updatedAt'])
            && (!ak.hasAny(['isActivated']) || incoming().get('isActivated', false) is bool)
            && incoming().get('isActivated', false) == true
            && incoming().get('referralsCount', 0) == existing().get('referralsCount', 0) + 1)
        || isAdmin();
    }
    function usersCreateOk(uid) {
      let base = isBaseAdmin();
      let ms = permFromAdminsDoc('manage_students');
      let mn = permFromAdminsDoc('manage_notifications');
      return isSignedIn()
        && ((request.auth.uid == userId
             && !incoming().keys().hasAny(['role', 'mustChangePassword', 'passwordChangedAt'])
             && (incoming().get('fullName', '') is string)
             && (incoming().get('approvalStatus', 'Pending') in ['Pending', 'Approved', 'Disapproved'])
             && (!('beginnerEnrollment' in incoming()) || validBeginnerSlot())
             && (request.auth.token.email != null
                 && incoming().get('email', '') is string
                 && incoming().get('email', '').lower() == request.auth.token.email.lower())
             && (!('userId' in incoming()) || incoming().get('userId', '') == request.auth.uid)
             && (!('createdAt' in incoming()) || incoming().createdAt == request.time)
             && (!('updatedAt' in incoming()) || incoming().updatedAt == request.time))
            || base || ms || mn);
    }
    // Entity Validation: Course
    function isValidCourse(data) {
      return data.keys().hasAll(['title']) 
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && (!data.keys().hasAll(['publish_status']) || data.publish_status in ['Draft', 'Published', 'Archived', 'draft', 'published', 'draft', 'Published']);
    }
    
    // Entity Validation: AdminConfig
    function isValidAdminConfig(data) {
      return data.keys().hasAll(['email'])
        && data.email is string && data.email.size() <= 200
        && (data.get('role', '') is string && data.get('role', '').size() <= 200)
        && (data.get('permissions', []) is list);
    }

    // Entity Validation: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['email'])
        && data.email is string && data.email.size() <= 200
        && (data.get('intent', '') is string && data.get('intent', '').size() <= 5000)
        && (data.get('experience', '') is string && data.get('experience', '').size() <= 5000)
        && (data.get('courseType', '') is string && data.get('courseType', '').size() <= 500)
        && (data.get('pathwaySelection', '') is string && data.get('pathwaySelection', '').size() <= 5000)
        && (data.get('pathwayReason', '') is string && data.get('pathwayReason', '').size() <= 5000)
        && (data.get('pathwayExperience', '') is string && data.get('pathwayExperience', '').size() <= 5000)
        && (data.get('recommendedPath', '') is string && data.get('recommendedPath', '').size() <= 5000)
        && (data.get('goal', '') is string && data.get('goal', '').size() <= 5000)
        && (data.get('availability', '') is string && data.get('availability', '').size() <= 5000)
        && (data.get('fullName', '') is string && data.get('fullName', '').size() <= 1000)
        && (data.get('gender', '') is string && data.get('gender', '').size() <= 200)
        && (data.get('ageRange', '') is string && data.get('ageRange', '').size() <= 200)
        && (data.get('learningTool', '') is string && data.get('learningTool', '').size() <= 500)
        && (data.get('educationLevel', '') is string && data.get('educationLevel', '').size() <= 500)
        && (data.get('whatsapp', '') is string && data.get('whatsapp', '').size() <= 500)
        && (data.get('state', '') is string && data.get('state', '').size() <= 500)
        && (data.get('country', '') is string && data.get('country', '').size() <= 200)
        && (data.get('cohort', '') is string && data.get('cohort', '').size() <= 200)
        && (data.get('referralCode', '') is string && data.get('referralCode', '').size() <= 500)
        && (data.get('myReferralCode', '') is string && data.get('myReferralCode', '').size() <= 500)
        && (data.get('isActivated', false) is bool)
        && (data.get('referralsCount', 0) is int || data.get('referralsCount', 0) is float)
        && (data.get('approvalStatus', 'Pending') is string && data.get('approvalStatus', 'Pending') in ['Pending', 'Approved', 'Disapproved'])
        && (data.get('isDashboardUnlocked', false) is bool)
        && (data.get('adminCode', '') is string && data.get('adminCode', '').size() <= 200)
        && (data.get('membershipId', '') is string && data.get('membershipId', '').size() <= 200)
        && (data.get('badgePaymentRequestStatus', '') is string && data.get('badgePaymentRequestStatus', '').size() <= 200)
        && (data.get('hasYearBadge', false) is bool)
        && (data.get('badgeExpiresAt', '') is string && data.get('badgeExpiresAt', '').size() <= 200)
        && (data.get('badgeStatus', '') is string && data.get('badgeStatus', '').size() <= 200)
        && (data.get('badgePlan', '') is string && data.get('badgePlan', '').size() <= 200)
        && (data.get('badgePrice', 0) is int || data.get('badgePrice', 0) is float)
        && (data.get('badgeApprovedAt', '') is string && data.get('badgeApprovedAt', '').size() <= 200)
        && (data.get('badgeTxRef', '') is string && data.get('badgeTxRef', '').size() <= 500)
        && (data.get('paymentReference', '') is string && data.get('paymentReference', '').size() <= 500)
        && (data.get('promptCopies', []) is list)
        && (data.get('registeredCourses', []) is list)
        && (data.get('congratulatedCourses', []) is list)
        && (data.get('completedCoursesOverride', []) is list)
        && (data.get('progress', {}) is map)
        && (data.get('manualDayUnlock', {}) is map)
        && (data.get('photoURL', '') is string && data.get('photoURL', '').size() <= 5000)
        && (data.get('avatarUrl', '') is string && data.get('avatarUrl', '').size() <= 5000)
        && (data.get('role', '') is string && data.get('role', '').size() <= 100)
        && (data.get('track', '') is string && data.get('track', '').size() <= 200)
        && (data.get('occupation', '') is string && data.get('occupation', '').size() <= 500)
        && (data.get('paymentProofUrl', '') is string && data.get('paymentProofUrl', '').size() <= 2000)
        && (data.get('paymentSubmittedAt', '') is string && data.get('paymentSubmittedAt', '').size() <= 200)
        && (data.get('paymentRejectReason', '') is string && data.get('paymentRejectReason', '').size() <= 2000)
        && (data.get('paymentApprovedAt', '') is string && data.get('paymentApprovedAt', '').size() <= 200)
        && (data.get('enrollmentStatus', '') is string && data.get('enrollmentStatus', '').size() <= 200)
        && (data.get('aiEnrollmentStatus', '') is string && data.get('aiEnrollmentStatus', '').size() <= 200)
        && (data.get('enrolledCourses', []) is list)
        && (data.get('courseEnrollments', {}) is map)
        && (!('beginnerEnrollment' in data) || (
              data.get('beginnerEnrollment', {}) is map
              && data.get('beginnerEnrollment', {}).keys().hasOnly(['courseId', 'completed', 'startedAt'])
              && data.get('beginnerEnrollment', {}).get('courseId', '') is string
              && data.get('beginnerEnrollment', {}).get('completed', false) is bool
            ));
    }
    
    // Entity Validation: KycbQuestionnaire
    function isValidKycbQuestionnaire(data) {
      return data.keys().hasAll(['clientName', 'type', 'businessName', 'createdAt', 'data'])
        && data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 200
        && data.type in ['lp', 'ec']
        && data.businessName is string && data.businessName.size() > 0 && data.businessName.size() <= 200
        && (data.get('dateCompleted', '') is string && data.get('dateCompleted', '').size() <= 100)
        && (data.get('userId', '') is string && data.get('userId', '').size() <= 128)
        && (data.get('userEmail', '') is string && data.get('userEmail', '').size() <= 200)
        && data.data is map;
    }

    // Entity Validation: SavedPrompt
    function isValidSavedPrompt(data) {
      return data.keys().hasAll(['userId', 'industry', 'promptText', 'websiteType', 'createdAt'])
        && data.userId is string && data.userId.size() <= 128
        && data.industry is string && data.industry.size() <= 200
        && data.promptText is string && data.promptText.size() <= 100000
        && data.websiteType in ['landing', 'ecommerce']
        && (data.get('businessName', '') is string && data.get('businessName', '').size() <= 200);
    }

    // Entity Validation: AssignmentSubmission
    function isValidAssignmentSubmission(data) {
      return data.keys().hasAll(['userId', 'courseId', 'dayIndex', 'status', 'createdAt'])
        && data.userId is string
        && data.courseId is string
        && data.dayIndex is int
        && data.status in ['Pending', 'Approved', 'Disapproved']
        && (data.get('userName', '') is string)
        && (data.get('userEmail', '') is string)
        && (data.get('submittedText', '') is string)
        && (data.get('fileUrl', '') is string)
        && (data.get('fileName', '') is string)
        && (data.get('adminReason', '') is string)
        && (data.get('gradedBy', '') is string);
    }

    // Entity Validation: Notification
    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message', 'isRead', 'createdAt'])
        && data.userId is string
        && data.title is string
        && data.message is string
        && data.isRead is bool;
    }

    // Entity Validation: NotificationTemplate
    function isValidNotificationTemplate(data) {
      return data.keys().hasAll(['id', 'title', 'message', 'triggerType', 'eventType', 'createdAt'])
        && data.id is string
        && data.title is string
        && data.message is string
        && data.triggerType is string
        && data.eventType is string;
    }

    // Entity Validation: BlogPost
    function isValidBlogPost(data) {
      return data.keys().hasAll(['title', 'content', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.content is string && data.content.size() > 0 && data.content.size() <= 100000
        && (data.get('imageUrl', '') is string && data.get('imageUrl', '').size() <= 2000)
        && (data.get('author', '') is string && data.get('author', '').size() <= 200)
        && (data.get('publishedDate', '') is string && data.get('publishedDate', '').size() <= 100);
    }

    // Entity Validation: BuzzGroup
    function isValidBuzzGroup(data) {
      return data.keys().hasAll(['name'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && (data.get('description', '') is string && data.get('description', '').size() <= 2000)
        && (data.get('category', 'general') is string && data.get('category', 'general').size() <= 100)
        && (data.get('imageUrl', '') is string && data.get('imageUrl', '').size() <= 2000)
        && (data.get('allowStudentsChat', true) is bool)
        && (data.get('createdBy', '') is string && data.get('createdBy', '').size() <= 200)
        && (data.get('lastMessage', '') is string && data.get('lastMessage', '').size() <= 500)
        && (data.get('lastMessageSender', '') is string && data.get('lastMessageSender', '').size() <= 200)
        && (data.get('lastMessageTime', 0) is int || data.get('lastMessageTime', 0) is float)
        && (data.get('createdAt', 0) is int || data.get('createdAt', 0) is float)
        && (data.get('membersCount', 1) is int || data.get('membersCount', 1) is float)
        && (data.get('isPersonal', false) is bool)
        && (data.get('ownerUid', '') is string)
        && (data.get('isProOnly', false) is bool)
        && (data.get('isAdminOnly', false) is bool);
    }

    // Entity Validation: BuzzMessage
    function isValidBuzzMessage(data) {
      return data.keys().hasAll(['groupId', 'senderUid', 'senderName'])
        && data.groupId is string && data.groupId.size() > 0 && data.groupId.size() <= 128
        && data.senderUid is string && data.senderUid.size() > 0 && data.senderUid.size() <= 128
        && data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 200
        && (data.get('senderEmail', '') is string && data.get('senderEmail', '').size() <= 200)
        && (data.get('senderPhoto', '') is string && data.get('senderPhoto', '').size() <= 2000)
        && (data.get('text', '') is string && data.get('text', '').size() <= 10000)
        && (data.get('mediaUrl', '') is string && data.get('mediaUrl', '').size() <= 2000)
        && (data.get('mediaType', '') is string && data.get('mediaType', '').size() <= 50)
        && (data.get('isAdmin', false) is bool)
        && (data.get('timestamp', 0) is int || data.get('timestamp', 0) is float)
        && (data.get('reactions', {}) is map)
        && (data.get('user_reactions', {}) is map)
        && (data.get('replyTo', {}) is map)
        && (data.get('starredBy', {}) is map);
    }

    // Collections Routes
    // BISECT2 probe functions (temporary)
    // BISECT3 probe functions (temporary)
    match /admins/{adminId} {
      // Any signed-in admin can see the admin team; non-admins can only read their own record
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow create: if (isBaseAdmin() || adminPerm('manage_admins'))
                    && isValidId(adminId)
                    && isValidAdminConfig(incoming());
      allow update: if (isBaseAdmin() || adminPerm('manage_admins'))
                    && isValidAdminConfig(incoming())
                    || (isSignedIn()
                        && request.auth.uid == adminId
                        && existing().get('mustChangePassword', false) == true
                        && incoming().get('mustChangePassword', true) == false
                        && incoming().diff(existing()).affectedKeys().hasOnly(['mustChangePassword', 'passwordChangedAt']));
      allow delete: if isBaseAdmin() || adminPerm('manage_admins');
    }

    // CIYA access codes: written and read only by server functions (admin SDK).
    // Students unlock their first course by typing the code from their email;
    // the database itself is never readable by clients.
    match /accessCodes/{codeId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if true;
      allow list: if true;
      allow create: if usersCreateOk(userId);
      allow update: if isSignedIn() && usersUpdateOk(userId);
      allow delete: if isBaseAdmin() || adminPerm('manage_students');
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if adminPerm('manage_courses');
    }

    match /kycb_questionnaires/{questionnaireId} {
      allow read: if isSignedIn() && (resource.data.get('userId', '') == request.auth.uid || adminPerm('manage_kycb'));
      allow list: if isSignedIn() && (resource.data.get('userId', '') == request.auth.uid || adminPerm('manage_kycb'));
      allow create: if isSignedIn()
                    && (incoming().get('userId', '') == request.auth.uid || adminPerm('manage_kycb'))
                    && isValidId(questionnaireId)
                    && isValidKycbQuestionnaire(incoming())
                    && incoming().createdAt == request.time;
      allow update: if isSignedIn()
                    && (resource.data.get('userId', '') == request.auth.uid || adminPerm('manage_kycb'))
                    && (incoming().get('userId', '') == request.auth.uid || adminPerm('manage_kycb'))
                    && isValidKycbQuestionnaire(incoming())
                    && (incoming().createdAt == request.time || incoming().createdAt == resource.data.createdAt);
      allow delete: if isSignedIn() && (resource.data.get('userId', '') == request.auth.uid || adminPerm('manage_kycb'));
    }

    match /saved_prompts/{promptId} {
      allow read, delete: if isSignedIn() && (resource.data.get('userId', '') == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.get('userId', '') == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                    && isValidId(promptId)
                    && isValidSavedPrompt(incoming())
                    && incoming().userId == request.auth.uid
                    && incoming().createdAt == request.time;
      allow update: if isSignedIn()
                    && isValidId(promptId)
                    && isValidSavedPrompt(incoming())
                    && incoming().userId == request.auth.uid
                    && incoming().userId == existing().userId
                    && incoming().createdAt == existing().createdAt
                    && incoming().promptText == existing().promptText;
    }

    match /assignments/{submissionId} {
      allow read, list: if isSignedIn() && (resource.data.get('userId', '') == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                    && isValidId(submissionId)
                    && isValidAssignmentSubmission(incoming())
                    && incoming().userId == request.auth.uid
                    && incoming().createdAt == request.time;
      allow update: if isSignedIn()
                    && (adminPerm('manage_assignments') || (incoming().userId == request.auth.uid && existing().get('userId', '') == request.auth.uid && (existing().status == "Pending" || existing().status == "Disapproved")));
      allow delete: if adminPerm('manage_assignments');
    }

    match /notifications/{notificationId} {
      allow read, list: if isSignedIn() && (resource.data.get('userId', '') == request.auth.uid || resource.data.get('userId', '') == 'all' || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn()
                    && (incoming().userId == request.auth.uid || adminPerm('manage_notifications'));
      allow delete: if adminPerm('manage_notifications');
    }

    match /notification_templates/{templateId} {
      allow read, list: if isSignedIn();
      allow write: if adminPerm('manage_notifications');
    }

    match /blog/{postId} {
      allow read: if true;
      allow create: if adminPerm('manage_blog')
                    && isValidId(postId)
                    && isValidBlogPost(incoming())
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;
      allow update: if adminPerm('manage_blog')
                    && isValidBlogPost(incoming())
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time;
      allow delete: if adminPerm('manage_blog');
    }

    match /settings/{settingsDoc} {
      allow read: if true;
      allow write: if adminPerm('manage_settings') || adminPerm('manage_leaderboard') || adminPerm('manage_kycb');
    }

    match /system_signals/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /buzz_groups/{groupId} {
      allow read, list: if true;
      allow create: if (isSignedIn() && groupId == 'personal_' + request.auth.uid && incoming().get('isPersonal', false) == true && incoming().get('ownerUid', '') == request.auth.uid)
                    || ((isAdmin() || isBaseAdmin()) && isValidBuzzGroup(incoming()));
      allow update: if (isAdmin() || isBaseAdmin())
                    || (isSignedIn() && groupId == 'personal_' + request.auth.uid && existing().get('ownerUid', '') == request.auth.uid)
                    || (isSignedIn() && isValidBuzzGroup(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastMessageTime', 'lastMessageSender']));
      allow delete: if isAdmin() || isBaseAdmin();

      match /messages/{messageId} {
        allow read, list: if true;
        allow create: if isSignedIn()
          && isValidBuzzMessage(incoming())
          && incoming().senderUid == request.auth.uid
          && (
            isAdmin() || isBaseAdmin() ||
            get(/databases/$(database)/documents/buzz_groups/$(groupId)).data.get('allowStudentsChat', true) == true
          );
        allow update: if isSignedIn()
          && (
            (incoming().diff(existing()).affectedKeys().hasOnly(['reactions', 'user_reactions']))
            ||
            (incoming().diff(existing()).affectedKeys().hasOnly(['starredBy']))
          );
        allow delete: if isAdmin() || isBaseAdmin() || (isSignedIn() && existing().senderUid == request.auth.uid);
      }
    }

    // Course Enrollments: students create their enrollment & payment proofs; admins review & toggle approval
    match /enrollments/{enrollmentId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || isBaseAdmin() || 
        resource.data.userId == request.auth.uid ||
        incoming().userId == request.auth.uid
      );
      allow delete: if isAdmin() || isBaseAdmin();
    }

    // Collection Group rule for 'Favourite' messages view
    match /{path=**}/messages/{messageId} {
      allow read, list: if isSignedIn();
    }

    match /users/{userId}/favourites/{msgId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }    // PHANTOM-EVAL probes (temporary)
  }
}
